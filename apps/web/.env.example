# Public build-time values; never put credentials or API tokens in VITE_*.
# Copy to apps/web/.env.local only after infrastructure confirms this contract.
# Same-origin proxy: GET /umami/script.js and POST /umami/api/send.
VITE_UMAMI_SCRIPT_URL=/umami/script.js
VITE_UMAMI_HOST_URL=/umami
# PENDING: infrastructure must create/verify T3's own Website ID. Blank disables analytics.
VITE_UMAMI_WEBSITE_ID=
# Exact public hostname, without scheme, port, path, or wildcard.
VITE_UMAMI_ALLOWED_HOSTNAME=t3-designer.orchid-labs.xyz
