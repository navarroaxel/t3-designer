{
  "name": "t3-designer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "blender:check": "uv run scripts/blender/check_mcp.py",
    "blender:sample": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python-exit-code 1 --python scripts/blender/create_door_frame.py",
    "scene:snapshot": "node scripts/export_scene.ts",
    "blender:assets": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python-exit-code 1 --python scripts/blender/create_current_assets.py",
    "blender:apartment": "pnpm scene:snapshot && \"/Applications/Blender.app/Contents/MacOS/Blender\" --background --factory-startup --python-exit-code 1 --python scripts/blender/assemble_apartment.py"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "turbo": "^2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
